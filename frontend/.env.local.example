# BACKEND_URL is the single switch every later ticket (and Round 2) uses to
# move between the mock backend and the real backend.
#
# No other file in this project should hardcode a backend URL — all
# /api/v1/* requests from the Next.js app are rewritten (see next.config.js)
# to ${BACKEND_URL}/api/v1/*.
#
# Copy this file to .env.local and set the value for your environment:
#   cp .env.local.example .env.local
#
# Example (mock backend running locally):
BACKEND_URL=http://localhost:4010

# Example (pointing at a real backend):
# BACKEND_URL=https://api.example.com
